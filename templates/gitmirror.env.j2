# {{ ansible_managed }}
#
# Read by the git-cache-proxy unit as a systemd EnvironmentFile, so the token
# reaches the daemon through its environment and never appears in the unit's
# argv or in "ps". systemd opens this as root, before dropping to the service
# account, which is why the file can stay root-owned 0600 and unreadable by the
# daemon's own user. The daemon passes it to git as http.extraHeader on
# upstream clone and fetch only; it is never sent to a client, and clients are
# served anonymously over loopback.
#
# Unquoted on purpose. A systemd EnvironmentFile takes the rest of the line
# literally, spaces and colons included, but it does strip a surrounding pair
# of quotes — so quoting here would be silently dropped at best and, if only
# one quote survived, corrupt the header.
#
# This is the one file in the github block that holds the credential. Mode
# "proxy" keeps it in the nginx vhost instead; mode "false" writes neither.
GITCACHEPROXY_UPSTREAM_AUTH_HEADER=Authorization: Basic {{ ('x-access-token:' ~ dronerunner_github_token) | b64encode }}
