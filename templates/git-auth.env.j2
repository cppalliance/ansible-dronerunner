# Written by the role (root 0600) and passed to the drone runner via
# DRONE_RUNNER_ENV_FILE. The runner merges these into every pipeline step's
# environment; the built-in clone step and every "git clone" inside the build
# both inherit it. See tasks/linux.yml and startdronerunner.sh.
#
# Nginx reverse proxy on the host (gitproxy.conf.j2) sits in front of github.com
# and adds a read-only token upstream. This file only tells git to send all
# github.com clone traffic to that proxy; no credential is present here, in any
# container, environment dump, or CI log. The URL is the docker bridge gateway
# (10.201.0.1 and friends), which every container on the bridge can reach by IP
# without DNS or /etc/hosts.
#
# GIT_CONFIG_PARAMETERS is used over GIT_CONFIG_COUNT/KEY/VALUE because the
# former works on every git in the fleet (the latter needs git >= 2.31, and
# droneubuntu2004 ships 2.29).
GIT_CONFIG_PARAMETERS="'url.http://{{ dronerunner_githubproxy_gateway }}:{{ dronerunner_githubproxy_port }}/.insteadOf=https://github.com/'"
